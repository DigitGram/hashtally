#: src/ui_settings.py
msgid "Measures how fast this computer calculates each algorithm and recommends one."
msgstr "Вимірює, як швидко цей комп’ютер обчислює кожен алгоритм, і радить один із них."

#: src/ui_common.py
msgid "Only finds accidental errors"
msgstr "Виявляє лише випадкові помилки"

#: src/ui_common.py
msgid "No longer secure"
msgstr "Більше не безпечний"

#: src/ui_common.py
msgid "Secure"
msgstr "Безпечний"

#: src/ui_common.py
msgid "How much data this computer can check per second. A longer bar is faster. Your drive is often slower, and then it sets the pace."
msgstr "Скільки даних цей комп’ютер може перевірити за секунду. Довша смуга означає швидше. Накопичувач часто повільніший і тоді саме він визначає швидкість."

#: src/ui_common.py
msgid "CRC32 is faster, but it only finds accidental errors, not deliberate changes."
msgstr "CRC32 швидший, але виявляє лише випадкові помилки, а не навмисні зміни."

#: src/ui_common.py
msgid "{name} is faster, but it is no longer secure against deliberate changes."
msgstr "{name} швидший, але вже не захищає від навмисних змін."

#: src/ui_common.py
msgid "Recommendation"
