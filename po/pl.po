#: src/ui_common.py
msgid "Not yet"
msgstr "Jeszcze nie"

#: src/ui_common.py
msgid "Yes, import key"
msgstr "Tak, importuj klucz"

#: src/ui_common.py
msgid "Only import the key once you have compared its fingerprint with the one on the publisher's official website. A forged key makes a forged hash file look genuine, and HashTally cannot tell the difference.\n\nIf you have not done that yet, do it first. The import is just as quick afterwards."
msgstr "Zaimportuj klucz dopiero po porównaniu jego odcisku z odciskiem na oficjalnej stronie wydawcy. Sfałszowany klucz sprawia, że sfałszowany plik z sumami wygląda na prawdziwy, a HashTally nie potrafi tego rozpoznać.\n\nJeśli jeszcze tego nie zrobiono, zrób to najpierw. Import zajmie potem tylko chwilę."

