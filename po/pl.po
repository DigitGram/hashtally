#: src/ui_common.py
msgid "HashTally will fetch the key with this fingerprint from keyserver.ubuntu.com and add it to your keyring. The server learns your IP address.\n\nBefore you go on, compare this fingerprint with the one on the publisher's website:"
msgstr "HashTally pobierze klucz o tym odcisku z keyserver.ubuntu.com i doda go do Twojego zestawu kluczy. Serwer pozna Twój adres IP.\n\nZanim przejdziesz dalej, porównaj ten odcisk z tym na stronie wydawcy:"

#: src/ui_common.py
msgid "Continue"
msgstr "Dalej"

